# Environment for the worker service (local development). See docs/CONFIGURATION.md for the full
# variable reference; the docker-compose stacks use the root .env instead.

APP_URL=http://localhost

# Enable posting commit statuses to GitHub/GitLab
# Defaults to true in production/staging, set to "true" for local testing
# ENABLE_VCS_STATUS=true

POSTGRES_USER=vizdiff
POSTGRES_PASS=vizdiff_password
POSTGRES_DATABASE=vizdiff
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-west-2
S3_BUCKET_NAME=vizdiff-artifacts
# Custom S3-compatible endpoint (e.g. a local MinIO); unset for real AWS S3.
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# GitLab (per-host service tokens, same values as the api; see docs/CONFIGURATION.md)
# ---------------------------------------------------------------------------
GITLAB_HOSTS=[{"host":"https://gitlab.com","token":"glpat-...","rejectUnauthorized":true}]
# Default host used to resolve a token when a task carries no explicit host.
GITLAB_HOST=https://gitlab.com
# Single-host fallback (used only when GITLAB_HOSTS is unset):
# GITLAB_TOKEN=glpat-...
# GITLAB_REJECT_UNAUTHORIZED=true

# ---------------------------------------------------------------------------
# GitHub (disabled by default; required when GITHUB_ENABLED=true)
# ---------------------------------------------------------------------------
GITHUB_ENABLED=false
# GITHUB_APP_ID=your_github_app_id
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_WEBHOOK_SECRET=your_webhook_secret

WORKER_HEALTH_PORT=3003

# Stories rendered concurrently per ingest (each is one headless-Chrome session).
# WORKER_STORY_CONCURRENCY=1

# Story readiness (issue #458; see docs/CONFIGURATION.md "Story readiness")
# Per-story render timeout: how long to wait for Storybook's story-render lifecycle to complete
# after navigation before marking the story failed.
# WORKER_STORY_RENDER_TIMEOUT_MS=30000
# Cap on a story's opt-in pre-capture delay (parameters.vizdiff.delay / parameters.chromatic.delay).
# WORKER_STORY_DELAY_MAX_MS=15000

# Browser-session resilience (issues #450/#453/#454; see docs/CONFIGURATION.md)
# Recycle each pooled Chrome session after this many rendered stories to bound cumulative memory
# growth over long builds. 0 disables recycling.
# WORKER_SESSION_RECYCLE_STORIES=150
# Timeout (ms) for the between-stories session health probe that detects a dead Chrome session.
# WORKER_SESSION_PROBE_TIMEOUT_MS=5000
# Replace a session after this many consecutive infrastructure-classified story failures.
# WORKER_SESSION_MAX_INFRA_FAILURES=2
# Maximum render attempts per story; only infra-classified failures are retried.
# WORKER_STORY_MAX_ATTEMPTS=2

# Per-story throughput (issue #456; see docs/CONFIGURATION.md)
# Background finalize tasks (S3 screenshot/diff uploads, baseline diff, DB save) processed
# concurrently after capture releases its browser session.
# WORKER_FINALIZE_CONCURRENCY=4
# Cap on stories captured but not yet finalized (each buffers one screenshot PNG in memory).
# WORKER_FINALIZE_QUEUE_LIMIT=16
# Interval (ms) between screenshots in the visual-stabilization loop (default halved from the
# former hardcoded 500; raise it back for storybooks with slow animations).
# WORKER_STABILIZE_INTERVAL_MS=250
# Settle delay (ms) after the post-stabilization viewport resize before the full-height capture.
# WORKER_POST_LOAD_DELAY_MS=250

# Build watchdog (issue #452; see docs/CONFIGURATION.md)
# Abort a build once no story has completed for this long (progress watchdog). 0 disables.
# WORKER_PROGRESS_TIMEOUT_MS=300000
# Per-story budget used to derive the whole-build timeout ceiling when BUILD_TIMEOUT_MS is unset:
# ceiling = max(BUILD_TIMEOUT_FLOOR_MS, ceil(storyCount * budget / WORKER_STORY_CONCURRENCY)).
# WORKER_PER_STORY_BUDGET_MS=5000
# Whole-build render timeout ceiling. Unset = derived from the story count; explicit = verbatim.
# BUILD_TIMEOUT_MS=900000
# Lower bound on the derived whole-build ceiling.
# BUILD_TIMEOUT_FLOOR_MS=900000
# How long to wait for an aborted render to unwind before the worker exits for a clean restart.
# BUILD_ABORT_GRACE_MS=10000
# RSS above which a build logs a memory-pressure warning (observational only).
# BUILD_MEMORY_WARN_BYTES=2147483648

# Cross-worker sharding (issue #456; see docs/CONFIGURATION.md "Cross-worker sharding")
# Split large builds into render_story_chunk tasks any worker replica can claim. Off by default;
# enable only after EVERY worker replica runs a version that understands the new task type.
# WORKER_SHARDING_ENABLED=true
# Stories per render chunk task.
# WORKER_SHARD_CHUNK_SIZE=50
# Minimum discovered story count before a build is sharded (smaller builds render inline).
# WORKER_SHARD_MIN_STORIES=100
# Task-queue claim lock expiry (minutes). Live owners heartbeat the lock every minute, so this
# only reclaims tasks from workers that died without releasing (SIGKILL/OOM). Keep it below the
# effective stuck-running threshold (max(WORKER_STUCK_RUNNING_MINUTES, 3x
# WORKER_PROGRESS_TIMEOUT_MS)) so an orphaned chunk resumes before the sweeper fails the build.
# WORKER_TASK_LOCK_TIMEOUT_MINUTES=10

# Upload sanity / safety limits (set any to 0 to disable that check)
# MAX_STORIES_PER_UPLOAD=1000
# MAX_TARBALL_FILES=50000
# MAX_EXTRACTED_BYTES=1073741824
# MAX_TARBALL_ENTRY_BYTES=268435456
# MAX_TARBALL_PATH_LENGTH=4096
# MAX_STORY_IDENTIFIER_LENGTH=2048
# --- Screenshot retention reaper (optional) ---
# Periodically deletes screenshot builds (DB rows + S3 objects) older than RETENTION_DAYS, while
# always keeping the most recent RETENTION_KEEP_LAST_N builds per project. Disabled by default
# because it permanently deletes data; set to "true" to enable.
# RETENTION_REAPER_ENABLED=true
# RETENTION_DAYS=90
# RETENTION_KEEP_LAST_N=10
# RETENTION_MAX_BUILDS_PER_SWEEP=200
# RETENTION_SWEEP_INTERVAL_MS=3600000
