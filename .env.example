# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public base URL of the deployment. Use https://... when serving behind TLS (see the optional
# docker-compose.tls.yml overlay). The session cookie's domain and the GitLab/GitHub status links
# are derived from this.
APP_URL=http://localhost
# Session-signing secret. Required in production (the api refuses to start without it).
# Generate a strong value with: openssl rand -hex 32
JWT_SECRET=change-me

# Public hostname for the optional Caddy TLS overlay (docker-compose.tls.yml). Only used by that
# overlay; leave unset for plain HTTP. Must resolve to this host's public IP with ports 80+443 open.
# VIZDIFF_DOMAIN=vizdiff.example.com

POSTGRES_USER=vizdiff
POSTGRES_PASS=vizdiff_password
POSTGRES_DATABASE=vizdiff
POSTGRES_PORT=5432

AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-west-2
S3_BUCKET_NAME=vizdiff-artifacts

# ---------------------------------------------------------------------------
# Authentication (pluggable AuthProvider)
# AUTH_PROVIDER: "oidc" (default in production) or "dev" (non-production fixed identity)
# ---------------------------------------------------------------------------
AUTH_PROVIDER=oidc

# OIDC / Microsoft Entra (MSAL). Required when AUTH_PROVIDER=oidc.
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_CLIENT_ID=your_oidc_client_id
OIDC_CLIENT_SECRET=your_oidc_client_secret
# Defaults to ${APP_URL}/api/auth/callback when unset.
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# Set to false only for self-signed IdPs (development/testing).
OIDC_REJECT_UNAUTHORIZED=true

# Dev auth provider (AUTH_PROVIDER=dev). Non-production only.
DEV_AUTH_EMAIL=dev@vizdiff.local

# ---------------------------------------------------------------------------
# GitLab (per-host service tokens)
# Multi-host: GITLAB_HOSTS is a JSON array of host configs. The service token needs
# `api` scope and Developer+ role to post commit statuses and read projects.
# ---------------------------------------------------------------------------
GITLAB_HOSTS=[{"host":"https://gitlab.com","token":"glpat-...","rejectUnauthorized":true}]
# Default host used to resolve a token when a payload/task carries no explicit host.
GITLAB_HOST=https://gitlab.com
# Single-host fallback (used only when GITLAB_HOSTS is unset):
# GITLAB_TOKEN=glpat-...
# GITLAB_REJECT_UNAUTHORIZED=true
# Global webhook secret (per-host webhookSecret in GITLAB_HOSTS takes precedence):
GITLAB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# GitHub (disabled by default; code paths retained behind the gate)
# ---------------------------------------------------------------------------
GITHUB_ENABLED=false
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Frontend (NEXT_PUBLIC_* are baked into the frontend at Next.js build time). Note: the
# docker-compose stacks do NOT pass these to the frontend image build — they only take effect
# when you build/run the frontend from source yourself (e.g. `yarn frontend dev` reading
# frontend/.env.local). Kubernetes deployments override them at runtime via the Helm chart's
# /config.js instead.
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_GITHUB_ENABLED=false

# Worker
WORKER_HEALTH_PORT=3003
# Story readiness (issue #458; see docs/CONFIGURATION.md "Story readiness"). The docker-compose
# stacks pass these to the worker via this .env file.
# WORKER_STORY_RENDER_TIMEOUT_MS=30000
# WORKER_STORY_DELAY_MAX_MS=15000
# Browser-session resilience (issues #450/#453/#454; see docs/CONFIGURATION.md): recycle Chrome
# after N stories (0 disables), dead-session health-probe timeout, consecutive-infra-failure
# replacement threshold, and per-story attempt budget for infra-classified failures.
# WORKER_SESSION_RECYCLE_STORIES=150
# WORKER_SESSION_PROBE_TIMEOUT_MS=5000
# WORKER_SESSION_MAX_INFRA_FAILURES=2
# WORKER_STORY_MAX_ATTEMPTS=2
# Per-story throughput (issue #456; see docs/CONFIGURATION.md): background finalize (S3 uploads,
# image diff, DB save) concurrency and its captured-but-unfinalized backlog cap, plus the
# stabilization screenshot interval (default halved from the former hardcoded 500) and the
# post-resize settle delay.
# WORKER_FINALIZE_CONCURRENCY=4
# WORKER_FINALIZE_QUEUE_LIMIT=16
# WORKER_STABILIZE_INTERVAL_MS=250
# WORKER_POST_LOAD_DELAY_MS=250
# Build watchdog (issue #452; see docs/CONFIGURATION.md): abort after this long with no story
# completed (0 disables), per-story budget for the derived whole-build ceiling, explicit ceiling
# override (unset = derived from story count), floor on the derived ceiling, and post-abort
# unwind grace before the worker restarts.
# WORKER_PROGRESS_TIMEOUT_MS=300000
# WORKER_PER_STORY_BUDGET_MS=5000
# BUILD_TIMEOUT_MS=900000
# BUILD_TIMEOUT_FLOOR_MS=900000
# BUILD_ABORT_GRACE_MS=10000
